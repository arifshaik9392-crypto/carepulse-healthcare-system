# CarePulse Production Environment Configuration Template
PORT=3000
NODE_ENV=development
JWT_SECRET=carepulse-super-secure-jwt-secret-key-2026-mohfw

# ==============================================================================
# 1. REAL EMAIL OTP CONFIGURATION (via standard SMTP / Gmail / SendGrid / Outlook)
# ==============================================================================
# For Gmail:
#   1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
#   2. Generate a 16-character App Password (myaccount.google.com/apppasswords)
#   3. Put your Gmail in SMTP_USER and the 16-char App Password in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CarePulse Health <no-reply@carepulse.org>"

# ==============================================================================
# 2. REAL PHONE SMS OTP CONFIGURATION (via Fast2SMS for India Mobile Numbers)
# ==============================================================================
# To get your Fast2SMS API Key:
#   1. Visit https://www.fast2sms.com and sign up / login
#   2. Go to Dev API section: https://www.fast2sms.com/dashboard/dev-api
#   3. Copy your "API Authorization Key" and paste it in FAST2SMS_KEY below
FAST2SMS_KEY=

# Optional Fast2SMS DLT parameters (only if using registered DLT header/template):
FAST2SMS_DLT_SENDER_ID=
FAST2SMS_DLT_MESSAGE_ID=

# Alternative Phone Provider (Twilio Verify or Twilio SMS):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ==============================================================================
# 3. OUTPERO AI VOICE CALLING GATEWAY (Optional queue alert calling)
# ==============================================================================
OUTPERO_API_KEY=
OUTPERO_AGENT_SLUG=
OUTPERO_LEAD_SECRET=
