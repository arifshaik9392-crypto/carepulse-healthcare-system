# CarePulse Production Environment Configuration Template
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# Email OTP Service Configuration (Set your SMTP details for real live Email OTP delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CarePulse Health <no-reply@carepulse.org>"

# Phone OTP Service Configuration (Twilio or Fast2SMS or Firebase Auth)
FIREBASE_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_KEY=

# Outpero AI Outbound Voice Calling Integration
# Create your voice agent at https://outpero.com to obtain these
OUTPERO_API_KEY=
OUTPERO_AGENT_SLUG=
OUTPERO_LEAD_SECRET=
